{
  "name": "pi-self-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "pi-self-harness": "./src/cli.ts"
  },
  "scripts": {
    "cli": "node --experimental-strip-types src/cli.ts",
    "image:node22": "docker build --tag pi-self-harness/node22:bookworm images/node22",
    "image:go126": "docker build --tag pi-self-harness/go126:bookworm images/go126",
    "images": "npm run image:node22 && npm run image:go126",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "fsevents@2.3.3": true
  }
}
